# API keys — never commit
.env

# Python
__pycache__/
*.pyc

# Model weights / large files
glm-work/models/

# venv
.venv/

# Audio outputs (regenerable, large binary files)
glm-work/outputs/**/*.wav
glm-work/outputs/**/*.ogg
glm-work/outputs/**/*.mp3

# Node (Playwright testing)
node_modules/
package-lock.json

# Playwright test recordings (regenerable, large binary files)
glm-work/outputs/playwright/*.webm
glm-work/outputs/playwright/*.png
glm-work/outputs/screenshots/*.png
