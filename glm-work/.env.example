# Copy this file to .env and fill in your API keys.
# .env is gitignored — never commit real keys.

# Groq (free tier, no credit card) — https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# SambaNova (free tier) — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=your_key_here

# Cerebras (free tier) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_key_here

# OpenRouter (aggregator, some free models) — https://openrouter.ai
OPENROUTER_API_KEY=your_key_here

# Google AI Studio (free tier, no card) — https://aistudio.google.com/apikey
# Free: Gemini 2.5 Flash (10 RPM, 250 RPD), Gemini 2.5 Pro (5 RPM, 100 RPD)
GOOGLE_API_KEY=your_key_here
